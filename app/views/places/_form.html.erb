
<%= simple_form_for([@place.doctor_profile, @place]) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :location %>
    <%= f.input :x %>
    <%= f.input :y %>
  </div>

  <div class="form-actions d-flex mb-2 flex-wrap py-2">
    <%= f.button :submit, class: 'btn btn-success px-4 py-2 rounded-2xl shadow bg-blue-600 hover:bg-blue-700 text-white font-semibold transition duration-200 me-2 mb-2' %>
  </div>
<% end %>
